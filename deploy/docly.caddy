# Site snippet for the shared edge Caddy (imported via `import /opt/edge/sites/*.caddy`).
# The host placeholder on the next line is replaced by scripts/deploy.sh with SUBDOMAIN.BASE_DOMAIN. Caddy gets TLS certs automatically.
__DOCLY_HOST__ {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# API: /api/* -> FastAPI (prefix stripped)
	handle_path /api/* {
		reverse_proxy docly-api:8000
	}
	# everything else -> Next.js
	handle {
		reverse_proxy docly-web:3000
	}
}
